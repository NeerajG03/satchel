{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "server/prompts/**"
    },
    "api/hook-capture.mjs": {
      "includeFiles": "server/prompts/**"
    }
  },
  "rewrites": [
    {"source":"/.well-known/oauth-protected-resource","destination":"/api/resource-metadata"},
    {"source":"/.well-known/oauth-protected-resource/api/mcp","destination":"/api/resource-metadata"},
    {"source":"/((?!api/|assets/|\\.well-known/).*)","destination":"/index.html"}
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]
  }]
}
