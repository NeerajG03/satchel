VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Only for running against a local Supabase (`supabase start`). Unset, the
# endpoints talk to the deployed database, which is the default on purpose:
# a variable nobody set must not change where tokens are verified.
# SATCHEL_SUPABASE_URL=http://127.0.0.1:54321
# Optional. The public address of this deployment, where the overnight pass is told to call. Defaults to the address the page is served from.
# VITE_SATCHEL_PUBLIC_URL=https://your-deployment.example
