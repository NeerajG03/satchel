VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Skill delivery. Server-only: never VITE_ prefixed, or they enter the browser bundle.
SATCHEL_GITHUB_APP_ID=your-github-app-client-id
SATCHEL_GITHUB_APP_PRIVATE_KEY=

# The app slug is not a secret: the browser needs it to build the install link.
VITE_SATCHEL_GITHUB_APP_SLUG=your-github-app-slug
