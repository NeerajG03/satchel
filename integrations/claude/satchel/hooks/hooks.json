{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.mjs\"",
            "timeout": 5
          }
        ],
        "matcher": "^(startup|clear|compact)$"
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:satchel:satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "SessionStart"
            },
            "timeout": 10
          }
        ],
        "matcher": "^(clear|compact)$"
      }
    ]
  }
}
