{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "UserPromptSubmit"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "SessionStart"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "PostCompact"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
