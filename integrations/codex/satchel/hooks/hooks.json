{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/bootstrap.mjs\"",
            "timeout": 5
          }
        ],
        "matcher": "^(startup|clear|compact|resume)$"
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "SessionStart"
            },
            "timeout": 10,
            "additionalContextLimit": 6000
          }
        ],
        "matcher": "^(startup|clear|compact|resume)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "satchel",
            "tool": "load_memory_context",
            "input": {
              "session_key": "${session_id}",
              "event": "UserPromptSubmit",
              "prompt": "${prompt}",
              "user_prompt": "${user_prompt}"
            },
            "timeout": 5,
            "additionalContextLimit": 2000
          }
        ]
      }
    ]
  }
}
