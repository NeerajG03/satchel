{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "timeout": 10
          }
        ],
        "matcher": "^(startup|clear|compact|resume)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/capture.mjs\"",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
