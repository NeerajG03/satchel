{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window, deep-link and browser-open permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "deep-link:default",
    "opener:default",
    "window-state:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
