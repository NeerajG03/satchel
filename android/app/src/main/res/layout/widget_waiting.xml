<?xml version="1.0" encoding="utf-8"?>
<!-- Wide: a strip with the light, the words and the count; the next to-do with Add and Skip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/waiting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/waiting_body"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/waiting_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">
        <ImageView android:id="@+id/waiting_light" android:layout_width="8dp" android:layout_height="8dp"
            android:src="@drawable/led_amber" android:importantForAccessibility="no" />
        <TextView android:id="@+id/waiting_word" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="WAITING FOR YOU"
            android:fontFamily="@font/dm_mono" android:letterSpacing="0.08" android:textSize="13sp"
            android:textColor="@color/waiting_on_strip" android:maxLines="1" />
        <TextView android:id="@+id/waiting_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/dm_mono" android:textSize="20sp" android:textColor="@color/waiting_on_strip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/waiting_item"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">
        <TextView android:id="@+id/waiting_line" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/dm_mono" android:letterSpacing="0.06" android:textSize="11sp"
            android:textColor="@color/waiting_muted" android:maxLines="1" />
        <TextView android:id="@+id/waiting_title" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="4dp" android:fontFamily="@font/newsreader"
            android:textSize="18sp" android:textColor="@color/waiting_on_body" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:id="@+id/waiting_keys" android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/waiting_add" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/waiting_key" android:gravity="center"
                android:fontFamily="@font/instrument_sans" android:textStyle="bold" android:textSize="15sp"
                android:textColor="@color/waiting_on_strip" android:text="Add to Tasks" />
            <TextView android:id="@+id/waiting_skip" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:background="@drawable/waiting_skip" android:gravity="center"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:fontFamily="@font/instrument_sans"
                android:textSize="15sp" android:textColor="@color/waiting_on_body" android:text="Skip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
