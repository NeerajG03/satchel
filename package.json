{
  "name": "satchel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "memories:embed": "node scripts/embed-memories.mjs",
    "verify:pgvector": "node scripts/verify-pgvector.mjs",
    "eval": "node eval/run.mjs",
    "consolidation:enable": "node --env-file-if-exists=.env scripts/enable-consolidation.mjs",
    "task-storage:provision": "node scripts/provision-task-storage.mjs",
    "task-storage:cleanup": "node scripts/cleanup-task-files.mjs",
    "plugins:build": "node scripts/build-plugins.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@langfuse/vercel-ai-sdk": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.9",
    "ai": "^7.0.107",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
